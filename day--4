Missing And Repeating:

apporach : hashmap
  class Solution {
    ArrayList<Integer> findTwoElement(int arr[]) {
        // code here
        HashMap<Integer,Integer>map=new HashMap<>();
        ArrayList<Integer>ans=new ArrayList<>();
        //put all element fom array to ahspmap
        for(int ele:arr){
            map.put(ele,map.getOrDefault(ele,0)+1);
        }
        int repeating = -1;
        int missing = -1;
        //now traverse on haspmap to chekc
       for(int i = 1; i <= arr.length; i++){
           
            if(!map.containsKey(i)){
                missing = i;
            }
       }
        //now for repeating
        for(int key:map.keySet()){
            if(map.get(key)==2){
                repeating =key;
            }
        }
        ans.add(repeating);
        ans.add(missing);
        return ans;
    }
}
