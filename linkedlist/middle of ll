import java.util.*;
class Node{
    int data;
    Node next;
    
    Node(int data){
        this.data=data;
        this.next=next;
    }
}
public class Main{
    //fucntion to find middle of linkedlist
    public static Node mid(Node head){
        Node slow=head;
        Node fast=head;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        return slow;
    }
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        Node head=null;
        Node tail=null;
        for(int i=0;i<n;i++){
            int x=sc.nextInt();
            Node newnode=new Node(x);
            if(head==null){
                head=tail=newnode;
            }else{
                tail.next=newnode;
                tail=newnode;
            }
        }
        Node ans=mid(head);//------------->> this is imp 
        System.out.println(ans);
    }
}
