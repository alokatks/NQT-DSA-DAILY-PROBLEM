//Problem Statement
//A company stores employee IDs in a singly linked list.
//Write a Java program to create the linked list and print the sum of all even-valued nodes.
//If there is no even node, print 0.  sample test case-->6  10 15 8 21 22 5--output --> 10 + 8 + 22 = 40
// sapmle test case :2--->5  1 3 5 7 9---output is 0

import java.util.*;
class Node{
    int data;
    Node next;
    
    Node(int data){
        this.data=data;
        this.next=null;
    }
}
public class Main{
    public static int even(Node head){
        Node temp=head;
        int sum=0;
        while(temp!=null){
            if(temp.data%2==0){
                sum=sum+temp.data;
            }
            temp=temp.next;
        }
        return sum;
    }
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        Node head=null;
        Node tail=null;
        for(int i=0;i<n;i++){
            int x=sc.nextInt();
            Node newnode=new Node(x);
            if(head==null){
                head=tail=newnode;
            }else{
                tail.next=newnode;
                tail=newnode;
            }
        }
        int ans=even(head);
        System.out.println(ans);
    }
}
