import java.util.*;
class Node{
    int data;
    Node next;
    
    Node(int data){
        this.data=data;
        this.next=null;
    }
}
public class Main{
    //fucntion to find to count even number in linkedlist
    public static int counteven(Node head){
        int count=0;
        Node temp=head;
        while(temp!=null){
            if(temp.data%2==0){
                count++;
            }
            temp=temp.next;
        }
        return count;
    }
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        Node head=null;
        Node tail=null;
        for(int i=0;i<n;i++){
            int x=sc.nextInt();
            Node newnode=new Node(x);
            if(head==null){
                head=tail=newnode;
            }else{
                tail.next=newnode;
                tail=newnode;
            }
        }
        int ans=counteven(head);
        System.out.println("the number of even node is " + ans);
    }
