q)---wave array --
  apporach is : keep swapping number when it is bigger than right side 


    code::import java.util.*;

public class wavearray {
    // Wave array sorting logic
    public static void wave(int arr[]) {
        int n = arr.length;
        for (int i = 0; i < n - 1; i += 2) { // Crucial: i < n - 1 to avoid running out of bounds
            // Swap adjacent elements
            int temp = arr[i];
            arr[i] = arr[i + 1];
            arr[i + 1] = temp;
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter array size: ");
        int n = sc.nextInt();

        int[] arr = new int[n];
        System.out.println("Enter " + n + " elements: ");
        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        wave(arr);

        // Print the final result
        System.out.println(Arrays.toString(arr));
    }
}
