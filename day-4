2239. Find Closest Number to Zero --leetcode  
  import java.util.*;
 class Main{
    public static int close(int arr[],int n){
        int ans=arr[0];
        for(int i=1;i<arr.length;i++){
            if(Math.abs(arr[i])<Math.abs(ans)){
                ans=arr[i];
            }else if(Math.abs(arr[i])==Math.abs(ans) && arr[i]>ans){
                ans=arr[i];
            }
        }
        return ans;
    }
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[]arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int finalanswer=close(arr,n);
        System.out.println(finalanswer);
    
    }
}
