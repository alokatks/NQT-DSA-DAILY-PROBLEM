qq)--reverse a digit

  code:import java.util.*;
public class Reverseanumber {
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int digit=sc.nextInt();
        int rev=0;
        while(digit>0){
            int a=digit%10;
            rev=(rev*10)+a;
            digit=digit/10;
        }
        System.out.print("the reverse number is " + rev);
    }
