/****************************************************************************
MOVE ZEROS TO END 1, 2, 0, 4, 3, 0, 5, 0---->1, 2, 4, 3, 5, 0, 0, 0
*******************************************************************************/
import java.util.*;
public class Main{
    public static void print(int n,int arr[]){
        for(int i=0;i<n;i++){
            System.out.print(arr[i] + " ");
        }
    }
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        //new array 
        int[] nums=new int[n];
        int newidx=0;
        //count all non zero element and put in new array
        for(int i=0;i<arr.length;i++){
            if(arr[i]!=0){
                nums[newidx]=arr[i];
                newidx++;
            }
        }
        //count zeros now 
        int count=0;
        for(int i=0;i<arr.length;i++){
            if(arr[i]==0){
                count++;
            }
        }
        for(int i=0;i<count;i++){
            nums[newidx]=0;
            newidx++;
        }
        print(n,nums);
    }
}
