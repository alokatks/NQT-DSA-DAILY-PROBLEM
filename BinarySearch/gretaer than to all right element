import java.util.*;
public class Main{
    public static int count(int arr[]){
        int n=arr.length;
        int max=Integer.MIN_VALUE;
        int cnt=0;
        for(int i=0;i<n;i++){
            if(arr[i]>max){
                max=arr[i];
                cnt++;
            }
        }
        return cnt;
    }
    public static void main(String[]args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
        }
        int ans=count(arr);
        System.out.println(ans);
    }
}
